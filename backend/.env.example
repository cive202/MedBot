# --- Core ---
APP_NAME="MedAssist"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
FERNET_KEY=generate-via-python-cryptography-Fernet-generate_key

# --- Database (SQLite file under backend/data/) ---
DATABASE_URL=sqlite+aiosqlite:///./data/medassist.db

# --- Vector store (Chroma via LangChain) ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=disease_kb

# --- Auth / JWT ---
JWT_LIFETIME_SECONDS=900
REFRESH_LIFETIME_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Google OAuth (optional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- LLM ---
OLLAMA_URL=http://localhost:11434
MEDGEMMA_MODEL=medgemma:4b

# --- Frontend origins ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
